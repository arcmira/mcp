{
  "name": "@arcmira/mcp",
  "version": "0.7.10",
  "description": "Search YouTube and podcast transcripts. Mentions, momentum, sponsors, and organic recommendations.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "youtube",
    "youtube-transcript",
    "podcast",
    "podcast-transcripts",
    "transcripts",
    "claude",
    "cursor",
    "codex",
    "chatgpt"
  ],
  "private": true,
  "mcpName": "io.github.arcmira/arcmira",
  "license": "UNLICENSED",
  "author": "Arcmira",
  "homepage": "https://arcmira.com/docs/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcmira/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/arcmira/mcp/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./tests/register.mjs tests/*.test.ts",
    "manifest:check": "node --experimental-strip-types scripts/check-manifest.ts",
    "examples:check": "node --experimental-strip-types scripts/check-examples.ts",
    "identity:check": "bash scripts/check-commit-identity.sh",
    "skill:build": "node --experimental-strip-types scripts/build-skill.ts",
    "skill:check": "node --experimental-strip-types scripts/build-skill.ts --check",
    "sandbox:build": "node --experimental-strip-types scripts/build-sandbox.ts",
    "sandbox:check": "node --experimental-strip-types scripts/build-sandbox.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "wrangler": "4.126.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
